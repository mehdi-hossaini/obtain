  {
    "repository": "godotengine/godot",
    "type": "auto",
    "direct_add": true,
    "probe": "cli",
    "arguments": [
      "--path",
      "{home}/project",
      "--rendering-method",
      "gl_compatibility",
      "--audio-driver",
      "Dummy"
    ],
    "note": "Game engine: execute a generated scene with software OpenGL and save the rendered viewport.",
    "files": {
      "project/project.godot": "config_version=5\n[application]\nconfig/name=\"Obtain render probe\"\nrun/main_scene=\"res://main.tscn\"\n[display]\nwindow/size/viewport_width=256\nwindow/size/viewport_height=256\n[rendering]\nrenderer/rendering_method=\"gl_compatibility\"\n",
      "project/main.tscn": "[gd_scene load_steps=2 format=3]\n[ext_resource type=\"Script\" path=\"res://main.gd\" id=\"1\"]\n[node name=\"Probe\" type=\"Node2D\"]\nscript = ExtResource(\"1\")\n",
      "project/main.gd": "extends Node2D\nfunc _draw():\n\tdraw_rect(Rect2(0, 0, 256, 256), Color(0.15, 0.4, 0.85))\n\tdraw_circle(Vector2(128, 128), 64, Color(1.0, 0.6, 0.2))\nfunc _ready():\n\tawait RenderingServer.frame_post_draw\n\tvar image = get_viewport().get_texture().get_image()\n\tassert(image.save_png(\"res://render.png\") == OK)\n\tprint(\"OBTAIN_GODOT_RENDER_OK\")\n\tget_tree().quit()\n"
    },
    "probe_seconds": 60,
    "expected_output": "OBTAIN_GODOT_RENDER_OK",
    "expected_files": {
      "project/render.png": null
    }
  },
